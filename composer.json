{
	"name": "werkbot/newsletter-module",
	"description": "Newsletter module",
	"type": "silverstripe-vendormodule",
  "license": "MIT",
  "homepage": "https://github.com/werkbot/silverstripe-module-newsletter",
  "require": {
    "php": "^8.2",
    "silverstripe/cms": "^5.0 || ^6.0",
		"silverstripe/framework": "^5.0 || ^6.0",
    "campaignmonitor/createsend-php": "^7.0",
    "constantcontact/constantcontact": "^1.3",
    "activecampaign/api-php": "^2.0",
    "mailchimp/marketing": "^3.0"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/werkbot/mailchimp-marketing-php.git"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0",
    "wernerkrauss/silverstripe-rector": "^1"
  },
  "autoload": {
    "psr-4": {
      "Werkbot\\Newsletter\\": "src/"
    }
  },
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"silverstripe/vendor-plugin": true
		}
	}
}
